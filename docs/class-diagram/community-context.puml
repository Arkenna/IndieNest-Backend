@startuml
left to right direction
skinparam classAttributeIconSize 0

package "com.arkenna.indienest.backend.community"{
    package "domain"{
        package "model"{
            package "aggregates"{
                class Publication <<Aggregate root>>{
                    -id: PublicationId
                    -userId: UserId
                    -title: PublicationTitle
                    -comment: PublicationComment
                    -image: PublicationImage
                    -creationDate: Date
                    --
                    +Publication(command: CreatePublicationCommand)
                    +getId(): Int
                    +getUserId(): Int
                    +getTitle(): String
                    +getComment(): String
                    +getImage(): Boolean
                    +getCreationDate: String
                }
                class Answer <<Aggregate root>>{
                    -id: AnswerId,
                    -userId: UserId,
                    -publicationId: PublicationId
                    -comment: AnswerComment
                    -creationDate: Date
                    --
                    +Answer(command: CreateAnswerCommand)
                    +getId(): Int,
                    +getUserId(): Int
                    +getPublicationId(): Int
                    +getComment(): String
                    +getCreationDate(): String
                }
            }
            package "value objects"{
                class PublicationId <<Value object>>{
                    -value: Int
                }
                class AnswerId <<Value object>>{
                    -value: Int
                }
                class PublicationTitle <<Value object>>{
                    -value: String
                }
                class PublicationComment <<Value object>>{
                    -value: String | Null
                }
                class PublicationImage <<Value object>>{
                    -value: String | Null
                }
                class AnswerComment <<Value object>>{
                    -value: String
                }
            }
            package "commands"{
                record CreatePublicationCommand <<Command>>{
                    -userId: Int
                    -title: String | Null
                    -comment: String | Null
                    -image: String | Null
                }
                record CreateAnswerCommand <<Command>>{
                    -userId: Int
                    -publicationId: Int
                    -comment: String
                }
            }
            package "queries"{
                record GetAllPublicationsQuery <<Query>>{
                }
                record GetPublicationByIdQuery <<Query>>{
                    -id: PublicationId
                }
                record GetAllAnswersQuery <<Query>>{
                }
                record GetAnswerByIdQuery <<Query>>{
                    -id: AnswerId
                }
            }
        }
        package "services"{
            interface PublicationCommandService <<Service>>{
                +handle(CreatePublicationCommand): Optional<Publication>
            }
            interface AnswerCommandService <<Service>>{
                +handle(CreateAnswerCommand): Optional<Answer>
            }
            interface PublicationQueryService <<Service>>{
                +handle(GetAllPublicationsQuery): List<Publication>
                +handle(GetPublicationByIdQuery): Optional<Publication>
            }
            interface AnswerQueryService <<Service>>{
                +handle(GetAllAnswersQuery): List<Answer>
                +handle(GetAnswerByIdQuery): Optional<Answer>
            }
        }
    }
    package "infrastructure"{
        package "persistence"{
            package "jpa"{
                package "repositories"{
                    interface PublicationRepository <<Repository>>{
                        +findById(id: Int): Optional<Publication>
                    }
                    interface AnswerRepository <<Repository>>{
                        +findById(id: Int): Optional<Answer>
                    }
                }
            }
        }
    }
    package "application"{
        package "internal"{
            package "command services"{
                class PublicationCommandServiceImpl <<Service>>{
                    -publicationRepository: PublicationRepository
                    +handle(CreatePublicationCommand): Optional<Publication>
                }
                class AnswerCommandServiceImpl <<Service>>{
                    -answerRepository: AnswerRepository
                    +handle(CreateAnswerCommand): Optional<Answer>
                }
            }
            package "query services"{
                class PublicationQueryServiceImpl <<Service>>{
                    -publicationRepository: PublicationRepository
                    +handle(GetAllPublicationsQuery): List<Publication>
                    +handle(GetPublicationByIdQuery): Optional<Publication>
                }
                class AnswerQueryServiceImpl <<Service>>{
                    -answerRepository: AnswerRepository
                    +handle(GetAllAnswersQuery): List<Answer>
                    +handle(GetAnswerByIdQuery): Optional<Answer>
                }
            }
            package "acl" {
                class CommunityContextFacadeImpl <<ACL>>{
                    -publicationCommandService: PublicationCommandService
                    -publicationQueryService: PublicationQueryService
                    -answerCommandService: AnswerCommandService
                    -answerQueryService: AnswerQueryService
                    --
                    +CommunityContextFacadeImpl(PublicationCommandService, PublicationQueryService, AnswerCommandService, AnswerQueryService)
                    +createPublication(userId: Int, title: String, comment: String | Null, image: String | Null): Int
                    +createAnswer(userId: Int, publicationId: Int, comment: String): Int
                    +fetchPublicationById(id: Int): Publication
                    +fetchAllPublications(): List<Publication>
                    +fetchAnswerById(id: Int): <Answer>
                    +fetchAllAnswers(): List<Answer>
                }
            }
        }
    }
    package "interfaces"{
        package "rest"{
            package "controllers"{
                class PublicationsController <<Controller>>{
                    -publicationCommandService: PublicationCommandService
                    -publicationQueryService: PublicationQueryService
                    --
                    +PublicationsController(PublicationCommandService, PublicationQueryService)
                    +createPublication(CreatePublicationResource): ResponseEntity<PublicationResource>
                    +getAllPublications(): ResponseEntity<List<PublicationResource>>
                    +getPublicationById(id: Int): ResponseEntity<PublicationResource>
                }
                class AnswersController <<Controller>>{
                    -answerCommandService: AnswerCommandService
                    -answerQueryService: AnswerQueryService
                    --
                    +AnswersController(AnswerCommandService, AnswerQueryService)
                    +createAnswer(CreateAnswerResource): ResponseEntity<AnswerResource>
                    +getAllAnswers(): ResponseEntity<List<AnswerResource>>
                    +getAnswerById(id: Int): ResponseEntity<AnswerResource>
                }
            }
        }
        package "resources"{
            record PublicationResource <<Resource>>{
                +id: Int
                +userId: Int
                +title: String
                +comment: String | Null
                +image: String | Null
            }
            record AnswerResource <<Resource>>{
                +id: Int,
                +userId: Int
                +publicationId: Int
                +comment: String
            }
            record CreatePublicationResource <<Resource>>{
                +userId: Int
                +title: String
                +comment: String | Null
                +image: String | Null
            }
            record CreateAnswerResource <<Resource>>{
                +userId: Int
                +publicationId: Int
                +comment: String
            }
        }
        package "transform"{
            class CreatePublicationCommandFromResourceAssembler<<Assembler>>{
                +toCommandFromResource(createPublicationResource: CreatePublicationResource): CreatePublicationCommand {static}
            }
            class CreateAnswerCommandFromResourceAssembler<<Assembler>>{
                +toCommandFromResource(createAnswerResource: (CreateAnswerResource): CreateAnswerCommand {static}
            }
            class PublicationResourceFromEntityAssembler<<Assembler>>{
                +toResourceFromEntity(publication: Publication): PublicationResource {static}
            }
            class AnswerResourceFromEntityAssembler<<Assembler>>{
                +toResourceFromEntity(answer: Answer): AnswerResource {static}
            }
        }
        package "acl"{
            interface CommunityContextFacade<<ACL>>{
                --
                +createPublication(userId: Int, title: String, comment: String | Null, image: String | Null): Int
                +createAnswer(userId: Int, publicationId: Int, comment: String): Int
                +fetchPublicationById(id: Int): Publication
                +fetchAllPublications(): List<Publication>
                +fetchAnswerById(id: Int): <Answer>
                +fetchAllAnswers(): List<Answer>
            }
        }
    }
}

'DOMAIN LAYER
'aggregates
Answer --> AnswerId
Answer --> PublicationId
Answer --> AnswerComment
Answer ..> CreateAnswerCommand
Publication --> PublicationId
Publication --> PublicationTitle
Publication -->PublicationComment
Publication --> PublicationImage
Publication ..> CreatePublicationCommand
'queries
GetPublicationByIdQuery --> PublicationId
GetAnswerByIdQuery --> AnswerId
'services
PublicationCommandService ..> CreatePublicationCommand
PublicationQueryService ..> GetAllPublicationsQuery
PublicationQueryService ..> GetPublicationByIdQuery
AnswerCommandService ..> CreateAnswerCommand
AnswerQueryService ..> GetAllAnswersQuery
AnswerQueryService ..> GetAnswerByIdQuery

'APPLICATION LAYER
PublicationCommandServiceImpl ..|> PublicationCommandService
PublicationCommandServiceImpl --> PublicationRepository
AnswerCommandServiceImpl --> AnswerRepository
AnswerCommandServiceImpl ..|> AnswerCommandService
PublicationQueryServiceImpl ..|> PublicationQueryService
PublicationQueryServiceImpl --> PublicationRepository
AnswerQueryServiceImpl ..|> AnswerQueryService
AnswerQueryServiceImpl --> AnswerRepository
CommunityContextFacadeImpl ..|> CommunityContextFacade
CommunityContextFacadeImpl --> PublicationCommandService
CommunityContextFacadeImpl --> PublicationQueryService
CommunityContextFacadeImpl --> AnswerCommandService
CommunityContextFacadeImpl --> AnswerQueryService

'INTERFACES LAYER
CreatePublicationCommandFromResourceAssembler ..> CreatePublicationResource
CreateAnswerCommandFromResourceAssembler ..> CreateAnswerResource
PublicationResourceFromEntityAssembler ..> Publication
AnswerResourceFromEntityAssembler ..> Answer
PublicationsController ..> PublicationResource
PublicationsController --> PublicationCommandService
PublicationsController --> PublicationQueryService
AnswersController ..> AnswerResource
AnswersController --> AnswerCommandService
AnswersController --> AnswerQueryService






@enduml